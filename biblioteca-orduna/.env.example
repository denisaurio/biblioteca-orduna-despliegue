# ==============================================================
#  PLANTILLA DE SECRETOS DEL BACKEND
#  Copia este archivo como ".env" y completa los valores:
#    cp .env.example .env        (Linux/Mac)
#    copy .env.example .env      (Windows)
#  El .env real NUNCA se sube al repositorio.
# ==============================================================

# ---------- Cloudflare R2 (API compatible con S3) ----------
# Cloudflare > R2 > Overview = Account ID
# Cloudflare > R2 > Manage R2 Tokens = Access Key ID y Secret Access Key
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket PÚBLICO para las portadas de los libros
# Los buckets que falten los crea la aplicación: Configuración > Almacenamiento > "Preparar almacenamiento".
R2_BUCKET_PORTADAS=biblioteca
# Bucket PRIVADO para los PDFs de los libros virtuales
R2_BUCKET_PDFS=biblioteca-pdfs
# URL pública del bucket de portadas (bucket > Settings > Public Development URL)
# Ej: https://pub-<hash>.r2.dev   (el hash NO se puede deducir: hay que copiarlo del panel)
# Opcional: si la dejas vacía, las portadas las sirve el backend (/api/archivos/portadas/...).
# Para el VPS conviene ponerla: así Cloudflare entrega las imágenes y el backend no trabaja.
R2_URL_PUBLICO_PORTADAS=
# Dominio público propio del bucket de portadas (opcional), sin https://
# Ej: portadas.mibiblioteca.pe  ->  las portadas quedan en https://portadas.mibiblioteca.pe
R2_DOMINIO_PUBLICO=

# ---------- Escaner de ISBN (opcional) ----------
# Clave gratis de Google Books: evita que Google responda 429 desde el VPS.
GOOGLE_BOOKS_API_KEY=

# ---------- Base de datos ----------
# Solo en produccion (Coolify): URL JDBC completa del MySQL interno.
# DB_URL=jdbc:mysql://HOST:3306/biblioteca_orduna?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Lima&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=

# ---------- Produccion ----------
# JWT_SECRET=  (64+ caracteres al azar: openssl rand -base64 48)
# SHOW_SQL=false

# ---------- VPS ----------
# IP del servidor (o dominio si mas adelante se configura uno)
VPS_IP=
# URL publica del frontend (a donde vuelve el lector despues de pagar)
FRONTEND_URL=http://localhost:5173

# ---------- CORS ----------
# Orígenes del frontend permitidos, separados por coma.
# Agrega la IP del VPS: http://TU_IP
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500
